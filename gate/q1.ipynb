   "source": [
    "### find output of given code\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "13b7935b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "-3\n",
      "2\n"
     ]
    }
   ],
   "source": [
    "x = -7\n",
    "y = 3\n",
    "\n",
    "print(x // y)\n",
    "print(x % y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "e56bbbca",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "False\n"
     ]
    }
   ],
   "source": [
    "print(False and (10/0))\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "663920b7",
   "metadata": {},
   "source": [
    "### why:\n",
    "Python uses short-circuit evaluation—since False and ... is always False, it never evaluates 10 / 0, so no ZeroDivisionError occurs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "31a9a23b",
   "metadata": {},
   "outputs": [
